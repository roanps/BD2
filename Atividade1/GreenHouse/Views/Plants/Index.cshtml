@model IEnumerable<Greenhouse.Models.Plant>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Sensor_Value)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Sensor_Event)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Sensor_Value)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Sensor_Event)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Plant_Name">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Plant_Name">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Plant_Name">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
