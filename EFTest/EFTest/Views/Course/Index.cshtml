@model ICollection<EFTest.Models.Course>

@{
    ViewData["Title"] = "Cursos";
}

<div class="text-center">
    <h1 class="display-4">
        @Model.Count cursos.
    </h1>

    <a asp-controller="Course" asp-action="Create">Novo</a>
    <table class="table table-responsive table-hover table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nome</th>
                <th>Editar</th>
                <th>Excluir</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.ID</td>
                    <td>@s.Name</td>
                    <td>
                        <a asp-controller="Course"
                           asp-action="Edit"
                           class="btn btn-primary btn-sm"
                           asp-route-id="@s.ID">
                            Editar
                        </a>
                    </td>
                    <td>
                        <form asp-controller="Course" asp-action="Delete"
                              method="post">
                            <input type="hidden" name="id" value="@s.ID" />
                            <button type="submit"
                                    class="btn btn-danger btn-sm">
                                Excluir
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>

    </table>

</div>
