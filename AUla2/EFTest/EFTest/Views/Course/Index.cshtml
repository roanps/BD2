@model ICollection<EFTest.Models.Course>
@{
    ViewData["Title"] = "Cursos";
}

<div class="text-center">
    <h1 class="display-4">
        @Model.Count cursos.
    </h1>

    <a asp-controller=""></a>
    <table>
        <thead>
            <tr>
                <th>Id</th>
                <th>Nome</th>
        </thead>

        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.ID</td>
                    <td>@s.Name</td>
                    <td>
                        <a asp-controller="Home" asp-action="Edit" class="btn btn-primary" asp-route-id="@s.ID">
                            Editar
                        </a>
                        <a asp-controller="Home" asp-action="Delete" class="btn btn-primary" asp-route-id="@s.ID">
                            Excluir
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
